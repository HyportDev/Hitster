<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
           The Spotify session must not leave the device: the encrypted values would be useless on
           another one anyway, and a restored refresh token is a credential in a backup.
        -->
        <exclude domain="sharedpref" path="spotify_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spotify_session.xml" />
    </device-transfer>
</data-extraction-rules>
